    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
        // Apply saved theme before first paint to avoid flash of wrong theme
        if (localStorage.getItem('theme') === 'dark' ||
            (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        }
    </script>
    <script is:inline>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'system-ui', 'sans-serif'],
                        serif: ['"Instrument Serif"', 'Georgia', 'serif'],
                    },
                    // Tokens flip between light/dark via CSS variables, so no dark: prefixes needed
                    colors: {
                        paper: 'var(--paper)',
                        ink: 'var(--ink)',
                        mute: 'var(--mute)',
                        line: 'var(--line)',
                        accent: 'var(--accent)',
                    },
                }
            }
        }
    </script>
    <style>
        :root {
            --paper: #f6f4ee;
            --ink: #1b1a17;
            --mute: #6e6a62;
            --line: #d9d4c8;
            --accent: #b4441a;
        }

        .dark {
            --paper: #161513;
            --ink: #ebe7df;
            --mute: #9a958a;
            --line: #2d2b26;
            --accent: #e0703f;
        }

        html { background: var(--paper); }

        .serif { font-family: 'Instrument Serif', Georgia, serif; }

        /* Hairline underline that warms up on hover — used for inline links */
        .u {
            text-decoration: underline;
            text-decoration-thickness: 1px;
            text-underline-offset: 4px;
            text-decoration-color: var(--line);
            transition: text-decoration-color .2s;
        }

        .u:hover { text-decoration-color: var(--accent); }

        .portrait img {
            filter: grayscale(1) contrast(1.05);
            transition: filter .5s ease;
        }

        .portrait:hover img { filter: none; }

        /* Single, quiet entrance on load */
        .fade { animation: fade .8s ease both; }

        @keyframes fade {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: none; }
        }

        @media (prefers-reduced-motion: reduce) {
            .fade { animation: none; }
        }

        /* Price table stacks into cards on narrow screens */
        @media (max-width: 639px) {
            .price thead { display: none; }
            .price tbody, .price tr, .price td { display: block; text-align: left; padding: 0; }
            .price tr { padding: 1.25rem 0; }
            .price td + td { margin-top: .5rem; }
        }
    </style>
</head>

