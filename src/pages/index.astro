---
import articles from '../articles.json';

const articleDate = (date) => new Date(date).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });

const projects = [
    { title: 'OSS RBA — Online Single Submission', client: 'BKPM', sector: 'Pemerintahan', period: '2022 — 2025', url: 'https://oss.go.id',
      scope: 'Portal perizinan berusaha nasional. API integrasi Kementerian/Lembaga/Daerah, produk hukum digital, common service, dan monitoring service.',
      stack: 'Node.js · Rust · PostgreSQL · MongoDB · RabbitMQ · Redis' },
    { title: 'Finpay Billing Core', client: 'Finpay', sector: 'Fintech', url: 'https://hub.finpay.id/docs/finpay-billing/billing-payment',
      scope: 'API switching untuk manajemen channel dan transaksi pembayaran tagihan yang diteruskan ke biller.',
      stack: 'Go · MongoDB · Redis' },
    { title: 'MyPertamina Subsidi Tepat LPG', client: 'Pertamina', sector: 'Energi', url: 'https://subsiditepatlpg.mypertamina.id/merchant',
      scope: 'Enkripsi database, hashing, dan optimasi performa backend untuk transaksi subsidi merchant skala nasional.',
      stack: 'Go · Node.js · Kafka · MySQL' },
    { title: 'Tepi Bojonegoro Marketplace', client: 'Tepi Bojonegoro', sector: 'E-commerce', url: 'https://tepibojonegoro.com',
      scope: 'Platform e-commerce fullstack dengan integrasi payment gateway dan manajemen produk.',
      stack: 'Go (Echo) · Express · Next.js · PostgreSQL · Redis' },
    { title: 'Ase Logistik CMS', client: 'Antar Samudera Express', sector: 'Logistik', url: 'https://aselogistik.id/',
      scope: 'Fitur CMS untuk operasional pengiriman beserta peningkatan performanya.',
      stack: 'Laravel · MySQL' },
    { title: 'Progress+', client: 'Cipta Progresa Usaha', sector: 'Konstruksi', url: 'https://ciptaprogresa.com/progress',
      scope: 'Fitur CMS untuk monitoring progres proyek konstruksi.',
      stack: 'Laravel · MySQL' },
];

const extraProjects = [
    { title: 'Pertamina Informs', client: 'Pertamina', sector: 'Mobile backend', url: 'https://play.google.com/store/apps/details?id=com.pertamina.informs&hl=in&gl=US',
      scope: 'Wrapping API dashboard untuk aplikasi mobile Pertamina dan layanan notifikasi.',
      stack: 'Node.js · Kafka · MySQL · Firebase' },
    { title: 'Pijar Sekolah', client: 'Telkom Indonesia', sector: 'Edutech', url: 'https://pijarsekolah.id',
      scope: 'API manajemen user dashboard dan layanan pelaporan data pendidikan.',
      stack: 'Node.js · React' },
    { title: 'Yakes Telkom CMS', client: 'Yakes Telkom', sector: 'Kesehatan',
      scope: 'CMS kustom berbasis CodeIgniter dengan multi-user dan role-based access control.',
      stack: 'PHP (CodeIgniter) · MySQL' },
];

const services = [
    { name: 'Landing page & company profile', plan: 'Landing Page', time: '1–2 minggu', price: 'Rp 3 jt',
      scope: 'Website hingga 5 halaman, desain responsif, SEO dasar, tautan WhatsApp, dan deployment. Materi teks dan foto dari klien.' },
    { name: 'Backend API & integrasi', plan: 'Backend API', time: '2–4 minggu', price: 'Rp 7,5 jt',
      scope: 'API untuk satu alur bisnis, database, autentikasi, dokumentasi, dan deployment. Jumlah endpoint serta integrasi ditentukan dalam proposal.' },
    { name: 'Aplikasi web fullstack', plan: 'Aplikasi Web Fullstack', time: '4–8 minggu', price: 'Rp 15 jt',
      scope: 'Aplikasi dengan login, dashboard, dan hingga 3 modul sederhana sesuai kesepakatan. Termasuk source code, dokumentasi, deployment, dan perbaikan bug selama 30 hari.' },
    { name: 'Maintenance & support', plan: 'Maintenance', time: 'Bulanan', price: 'Rp 1,5 jt', unit: '/bln',
      scope: 'Hingga 5 jam kerja per bulan untuk perbaikan bug, pembaruan dependensi, dan pengecekan backup. Dikerjakan pada jam kerja; fitur baru dihitung terpisah.' },
];

const steps = [
    ['Diskusi kebutuhan', 'Membahas kebutuhan proyek, perkiraan biaya, dan waktu pengerjaan.'],
    ['Proposal & kesepakatan', 'Ruang lingkup tertulis, milestone, dan jadwal pembayaran: DP 50%, pelunasan saat serah terima.'],
    ['Desain & arsitektur', 'Menyepakati skema database, desain API, dan rancangan antarmuka sebelum pengembangan.'],
    ['Pengembangan', 'Pengerjaan bertahap dengan demo mingguan dan akses ke staging.'],
    ['Pengujian & UAT', 'Pengujian fungsional dan keamanan, lalu User Acceptance Test bersama Anda dengan sesi revisi.'],
    ['Go-live & serah terima', 'Deploy ke production, dokumentasi, source code, dan sesi handover. Garansi bug 30 hari setelah rilis.'],
];

const rail = [['#about', 'Tentang'], ['#experience', 'Pengalaman'], ['#portfolio', 'Proyek'], ['#skills', 'Keahlian'], ['#services', 'Layanan'], ['#process', 'Proses'], ['#articles', 'Tulisan'], ['#contact', 'Kontak']];
const nav = [['#about', 'Tentang'], ['#experience', 'Pengalaman'], ['#portfolio', 'Proyek'], ['#services', 'Layanan'], ['#articles', 'Tulisan']];
const cv = './assets/pdf/cv.pdf?v=2026-02';
const sectionClass = 'grid gap-6 border-t border-line py-16 scroll-mt-16 md:grid-cols-[200px_1fr] md:py-20';
---
<!DOCTYPE html>
<html lang="id" class="scroll-smooth">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wahyu Akbar Wibowo | Fullstack Developer</title>
    <meta name="description" content="Wahyu Akbar Wibowo — Fullstack Developer. Golang, Node.js, Rust, React/Next.js, dan PostgreSQL. Membangun sistem backend dan aplikasi web untuk pemerintahan, fintech, dan enterprise.">
    <meta name="author" content="Wahyu Akbar Wibowo">
    <meta name="theme-color" content="#faf8f5" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0a0a0b" media="(prefers-color-scheme: dark)">
    <link rel="icon" href="./assets/img/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="./assets/img/favicon-32.png" type="image/png" sizes="32x32">
    <link rel="apple-touch-icon" href="./assets/img/apple-touch-icon.png">
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Wahyu Akbar Wibowo",
        "jobTitle": "Fullstack Developer",
        "description": "Fullstack Developer — Golang, Node.js, Rust, React/Next.js, PostgreSQL. Membangun sistem backend dan aplikasi web untuk pemerintahan, fintech, dan enterprise.",
        "url": "https://wahyuakbarwibowo.github.io",
        "image": "https://wahyuakbarwibowo.github.io/assets/img/wahyu.jpg",
        "email": "mailto:wahyuakbar.work@gmail.com",
        "alumniOf": "Universitas Trunojoyo Madura",
        "sameAs": [
            "https://github.com/wahyuakbarwibowo",
            "https://www.linkedin.com/in/wahyu-akbar-wibowo"
        ]
    }
    </script>
    <link rel="canonical" href="https://wahyuakbarwibowo.github.io">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://wahyuakbarwibowo.github.io">
    <meta property="og:title" content="Wahyu Akbar Wibowo | Fullstack Developer">
    <meta property="og:description" content="Fullstack Developer. Golang, Node.js, Rust, React/Next.js, PostgreSQL. Sistem backend dan aplikasi web untuk pemerintahan, fintech, dan enterprise.">
    <meta property="og:image" content="https://wahyuakbarwibowo.github.io/assets/img/wahyu.jpg">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Wahyu Akbar Wibowo | Fullstack Developer">
    <meta name="twitter:description" content="Fullstack Developer — Go, Node.js, Rust, PostgreSQL.">
    <meta name="twitter:image" content="https://wahyuakbarwibowo.github.io/assets/img/wahyu.jpg">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Geist:wght@300..700&family=JetBrains+Mono:wght@400;500&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/assets/css/site.css">
        <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
        // Apply saved theme before first paint to avoid flash of wrong theme
        if (localStorage.getItem('theme') === 'dark' ||
            (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        }
    </script>
    <script is:inline>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Geist', 'system-ui', 'sans-serif'],
                        mono: ['"JetBrains Mono"', 'ui-monospace', 'monospace'],
                    },
                    // Tokens flip between light/dark via CSS variables, so no dark: prefixes needed
                    colors: {
                        paper: 'var(--paper)',
                        ink: 'var(--ink)',
                        mute: 'var(--mute)',
                        line: 'var(--line)',
                        accent: 'var(--accent)',
                        accent2: 'var(--accent-2)',
                        panel: 'var(--panel)',
                    },
                }
            }
        }
    </script>
    <style>
        .portrait img { filter: grayscale(1) contrast(1.05); }

        /* Single, quiet entrance on load */
        .fade { animation: fade .6s ease both; }

        @keyframes fade {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: none; }
        }

        /* Price table stacks into rows on narrow screens */
        @media (max-width: 639px) {
            .price thead { display: none; }
            .price tbody, .price tr, .price td { display: block; text-align: left; padding: 0; }
            .price tr { padding: 1.25rem 0; }
            .price td + td { margin-top: .5rem; }
        }
    </style>
</head>

<body class="relative font-sans text-ink antialiased selection:bg-accent selection:text-paper">
    <a href="#main-content" class="skip-link">Langsung ke konten</a>
    <canvas id="sun" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[100svh] w-full opacity-60 md:opacity-100" aria-hidden="true"></canvas>

    <!-- Section rail (desktop only) -->
    <nav class="fixed left-5 top-1/2 z-30 hidden -translate-y-1/2 flex-col border border-line bg-paper/60 backdrop-blur-sm xl:flex" aria-label="Navigasi section">
        {rail.map(([href, label], i) => <a href={href} title={label} aria-label={label} class="rail-item">
            <span class="text-xs text-mute">{String(i + 1).padStart(2, '0')}</span>
        </a>)}
    </nav>

    <!-- Navbar -->
    <nav class="sticky top-0 z-40 border-b border-line bg-paper/70 backdrop-blur-md" role="navigation" aria-label="Menu utama">
        <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
            <a href="#" class="flex items-center gap-2 text-sm font-medium"><span class="font-mono text-accent">~/</span>wahyu</a>

            <div class="hidden items-center gap-7 font-mono text-xs uppercase tracking-[.18em] lg:flex">
                {nav.map(([href, label]) => <a href={href} class="text-mute transition hover:text-ink">{label}</a>)}
                <button onclick="toggleDarkMode()" id="theme-toggle" aria-label="Ganti tema gelap/terang"
                    class="border border-line p-2 text-mute transition hover:text-ink">
                    <svg class="block h-4 w-4 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
                    </svg>
                    <svg class="hidden h-4 w-4 dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
                    </svg>
                </button>
                <a href="#contact" class="border border-line px-3 py-2 text-ink transition hover:border-accent hover:text-accent">Hubungi ↗</a>
            </div>

            <button class="p-2 lg:hidden" id="menu-button" aria-label="Buka menu navigasi" aria-expanded="false" aria-controls="mobile-menu">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 7h16M4 12h16M4 17h16"/>
                </svg>
            </button>
        </div>

        <div class="hidden border-t border-line lg:hidden" id="mobile-menu">
            <div class="mx-auto flex max-w-6xl flex-col px-6 py-4 text-lg">
                {nav.map(([href, label]) => <a href={href} class="py-2">{label}</a>)}
                <a href="#contact" class="py-2">Kontak</a>
                <div class="mt-3 flex items-center justify-between border-t border-line pt-4 text-sm text-mute">
                    <span>Ganti tema</span>
                    <button onclick="toggleDarkMode()" id="theme-toggle-mobile" aria-label="Ganti tema gelap/terang"
                        class="border border-line p-2">
                        <svg class="block h-4 w-4 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
                        </svg>
                        <svg class="hidden h-4 w-4 dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <main id="main-content" tabindex="-1" class="mx-auto max-w-6xl px-6">

        <!-- Hero -->
        <header class="fade flex min-h-[calc(100svh-4rem)] flex-col justify-center py-20">
            <p class="label !text-accent2">Fullstack Developer · Bojonegoro, ID</p>
            <h1 class="mt-6 text-[clamp(2.4rem,1.2rem+3.8vw,4.4rem)] font-medium leading-[0.98] tracking-tight">
                Backend dan web<br>
                <span class="text-mute">untuk pemerintahan,</span><br>
                <span class="text-accent">fintech &amp; energi</span>.
            </h1>
            <p class="mt-8 max-w-xl text-lg leading-relaxed text-mute">
                Sejak 2020 merancang API, database, dan integrasi layanan —
                termasuk OSS RBA (BKPM), Finpay Billing, dan MyPertamina Subsidi Tepat LPG.
            </p>

            <!-- Terminal-style contact box; tabs swap the command, COPY copies the value -->
            <div class="mt-10 w-full max-w-2xl">
                <div class="flex items-end justify-between gap-4">
                    <div class="flex gap-1" role="tablist" aria-label="Kontak">
                        <button class="term-tab is-active" role="tab" aria-selected="true" data-verb="mail" data-arg="wahyuakbar.work@gmail.com" data-copy="wahyuakbar.work@gmail.com">email</button>
                        <button class="term-tab" role="tab" aria-selected="false" data-verb="open" data-arg="github.com/wahyuakbarwibowo" data-copy="https://github.com/wahyuakbarwibowo">github</button>
                        <button class="term-tab" role="tab" aria-selected="false" data-verb="open" data-arg="linkedin.com/in/wahyu-akbar-wibowo" data-copy="https://www.linkedin.com/in/wahyu-akbar-wibowo">linkedin</button>
                    </div>
                    <span class="label hidden pb-2 sm:block">Konsultasi gratis</span>
                </div>
                <div class="flex items-stretch border border-line bg-panel font-mono text-sm">
                    <span class="flex items-center border-r border-line px-3 text-accent sm:px-4" aria-hidden="true">$</span>
                    <code class="min-w-0 flex-1 px-3 py-4 text-xs [overflow-wrap:anywhere] sm:px-4 sm:text-sm"><span id="term-verb" class="hidden text-mute sm:inline">mail </span><span id="term-arg">wahyuakbar.work@gmail.com</span></code>
                    <button id="term-copy" class="label border-l border-line px-3 sm:px-5 transition hover:text-ink" data-copy="wahyuakbar.work@gmail.com">Copy</button>
                </div>
            </div>

            <div class="mt-8">
                <p class="label">Stack utama</p>
                <p class="mt-3 font-mono text-sm text-mute">Go · Rust · Node.js · TypeScript · PostgreSQL · Kafka · Redis · React</p>
            </div>
        </header>

        <dl class="grid grid-cols-2 border-y border-line md:grid-cols-4">
            <div class="border-line py-6 pr-4 md:border-r"><dt class="label">Pengalaman</dt><dd class="mt-2 text-3xl font-medium tracking-tight">5+ tahun</dd></div>
            <div class="border-line py-6 pl-4 md:border-r md:px-6"><dt class="label">Proyek dirilis</dt><dd class="mt-2 text-3xl font-medium tracking-tight">10+</dd></div>
            <div class="border-t border-line py-6 pr-4 md:border-r md:border-t-0 md:px-6"><dt class="label">Sektor</dt><dd class="mt-2 text-3xl font-medium tracking-tight">Gov · Fin · Energi</dd></div>
            <div class="border-t border-line py-6 pl-4 md:border-t-0 md:px-6"><dt class="label">Pendidikan</dt><dd class="mt-2 text-3xl font-medium tracking-tight">S1, IPK 3.8</dd></div>
        </dl>
        <p class="label py-6 leading-relaxed">
            Pernah terlibat di proyek untuk&nbsp;&nbsp;<span class="text-ink">BKPM · Finpay · Pertamina · Telkom Indonesia · Antar Samudera Express</span>
        </p>

        <!-- About -->
        <section id="about" class={sectionClass}>
            <h2 class="label">01 / Tentang</h2>
            <div class="grid gap-10 md:grid-cols-[1fr_200px]">
            <div class="max-w-3xl space-y-5 text-lg leading-relaxed">
                <p>
                    Fokus saya di backend: desain database, API, keamanan data, dan integrasi antar layanan.
                    Untuk sisi antarmuka saya mengerjakan React dan Next.js.
                </p>
                <p class="text-mute">
                    Terbiasa bekerja di sistem yang melibatkan banyak pihak — Kementerian, Lembaga, Daerah, biller, dan vendor —
                    di mana kontrak API yang jelas, audit trail, dan dokumentasi sama pentingnya dengan kode.
                </p>
                <div class="flex flex-wrap gap-x-6 gap-y-3 pt-2 text-sm">
                    <a href="https://github.com/wahyuakbarwibowo" target="_blank" rel="noopener noreferrer" class="u">GitHub</a>
                    <a href="https://www.linkedin.com/in/wahyu-akbar-wibowo" target="_blank" rel="noopener noreferrer" class="u">LinkedIn</a>
                    <a href={cv} download="Wahyu_Akbar_Wibowo_CV.pdf" class="u">Unduh CV</a>
                </div>
            </div>
            <figure class="portrait w-full max-w-[180px] md:max-w-[200px]">
                <img src="./assets/img/wahyu.jpg" alt="Wahyu Akbar Wibowo" loading="lazy" width="640" height="611"
                    class="aspect-[4/5] w-full border border-line object-cover object-top">
            </figure>
            </div>
        </section>

        <!-- Experience -->
        <section id="experience" class={sectionClass}>
            <h2 class="label">02 / Pengalaman</h2>
            <ol class="divide-y divide-line border-y border-line">
                <li class="grid gap-2 py-6 sm:grid-cols-[170px_1fr]">
                    <p class="label pt-1">Jan 2026 — kini</p>
                    <div>
                        <h3 class="font-medium">Fullstack Developer <span class="font-normal text-mute">· Stealth Startup</span></h3>
                        <p class="mt-2 text-mute">Mengembangkan backend, API, database, dan antarmuka pengguna. Detail produk belum dipublikasikan.</p>
                    </div>
                </li>
                <li class="grid gap-2 py-6 sm:grid-cols-[170px_1fr]">
                    <p class="label pt-1">Mei — Des 2025</p>
                    <div>
                        <h3 class="font-medium">Back End Developer <span class="font-normal text-mute">· PT Padepokan Tujuh Sembilan</span></h3>
                        <ul class="mt-2 list-disc space-y-1 pl-5 text-mute marker:text-line">
                            <li>Mengembangkan RESTful API OSS RBA dengan Node.js/Express dan Rust (Actix Web).</li>
                            <li>Merancang modul, struktur data, dan query PostgreSQL untuk integrasi Kementerian, Lembaga, dan Daerah.</li>
                            <li>Meningkatkan monitoring service dan common service.</li>
                        </ul>
                    </div>
                </li>
                <li class="grid gap-2 py-6 sm:grid-cols-[170px_1fr]">
                    <p class="label pt-1">Agt 2020 — Apr 2025</p>
                    <div>
                        <h3 class="font-medium">Full Stack Developer <span class="font-normal text-mute">· PT Skyrain Studio Indonesia</span></h3>
                        <ul class="mt-2 list-disc space-y-1 pl-5 text-mute marker:text-line">
                            <li>Membangun dan memelihara aplikasi web untuk klien fintech (Finpay), energi (Pertamina), edutech, dan e-commerce.</li>
                            <li>Mengimplementasikan keamanan API: enkripsi data, hashing, dan kontrol akses berbasis peran.</li>
                            <li>Berkolaborasi dengan tim UI/UX, mengintegrasikan Kafka dan payment gateway.</li>
                        </ul>
                    </div>
                </li>
                <li class="grid gap-2 py-6 sm:grid-cols-[170px_1fr]">
                    <p class="label pt-1">2016 — 2020</p>
                    <div>
                        <h3 class="font-medium">S1 Teknik Informatika <span class="font-normal text-mute">· Universitas Trunojoyo Madura</span></h3>
                        <p class="mt-2 text-mute">IPK 3.8.</p>
                    </div>
                </li>
            </ol>
            <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm md:col-start-2">
                <button onclick="openCvModal()" class="u">Lihat CV lengkap</button>
                <a href={cv} download="Wahyu_Akbar_Wibowo_CV.pdf" class="u">Unduh PDF</a>
                <span class="label">Diperbarui Februari 2026</span>
            </div>
        </section>

        <!-- Projects -->
        <section id="portfolio" class={sectionClass}>
            <h2 class="label">03 / Proyek pilihan</h2>
            <div>
                <ul id="project-list" class="divide-y divide-line border-y border-line">
                    {[...projects, ...extraProjects].map((p, i) => {
                        const cls = 'group grid gap-x-6 gap-y-3 py-7 sm:grid-cols-[48px_1fr]';
                        const body = <>
                            <p class="label pt-1">{String(i + 1).padStart(2, '0')}</p>
                            <div>
                                <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                                    <h3 class="text-lg font-medium group-hover:text-accent">{p.title} {p.url && <span class="font-normal text-mute" aria-hidden="true">↗</span>}</h3>
                                    <p class="label">{p.sector}{p.period && ` · ${p.period}`}</p>
                                </div>
                                <dl class="mt-3 grid gap-x-6 gap-y-2 text-sm sm:grid-cols-[90px_1fr]">
                                    <dt class="label pt-0.5">Klien</dt><dd>{p.client}</dd>
                                    <dt class="label pt-0.5">Lingkup</dt><dd class="text-mute">{p.scope}</dd>
                                    <dt class="label pt-0.5">Stack</dt><dd class="font-mono text-xs leading-6 text-mute">{p.stack}</dd>
                                </dl>
                            </div>
                        </>;
                        // Projects past the first list stay hidden until toggleProjects() reveals them
                        const extra = i >= projects.length;
                        return <li class={extra ? 'hidden' : undefined} data-extra={extra || undefined}>{p.url
                            ? <a href={p.url} target="_blank" rel="noopener noreferrer" class={cls}>{body}</a>
                            : <div class={cls}>{body}</div>}</li>;
                    })}
                </ul>
                <button id="btn-load-more" onclick="toggleProjects()" class="u mt-5 text-sm" aria-expanded="false" aria-controls="project-list">
                    <span id="btn-text">Tampilkan 3 proyek lainnya</span>
                </button>
            </div>
        </section>

        <!-- Skills -->
        <section id="skills" class={sectionClass}>
            <h2 class="label">04 / Keahlian</h2>
            <dl class="grid border-t border-line sm:grid-cols-2">
                <div class="border-b border-line py-5 sm:pr-8">
                    <dt class="font-medium">Backend</dt>
                    <dd class="mt-1 text-mute">Go (Fiber, Echo, Gin), Node.js (NestJS, Express), Rust (Actix Web, Axum, Tokio), PHP (Laravel, CodeIgniter), TypeScript.</dd>
                </div>
                <div class="border-b border-line py-5 sm:border-l sm:pl-8">
                    <dt class="font-medium">Data & messaging</dt>
                    <dd class="mt-1 text-mute">PostgreSQL, MySQL, MongoDB, Redis, Kafka, RabbitMQ, optimasi query.</dd>
                </div>
                <div class="border-b border-line py-5 sm:pr-8">
                    <dt class="font-medium">API, keamanan & infrastruktur</dt>
                    <dd class="mt-1 text-mute">REST, GraphQL, JWT/OAuth, enkripsi & hashing, RBAC, Docker, CI/CD, Git (GitHub, GitLab, Gitea).</dd>
                </div>
                <div class="border-b border-line py-5 sm:border-l sm:pl-8">
                    <dt class="font-medium">Frontend & metodologi</dt>
                    <dd class="mt-1 text-mute">React, Next.js, Tailwind CSS, Firebase. Agile, Scrum, Kanban.</dd>
                </div>
            </dl>
        </section>

        <!-- Services & pricing -->
        <section id="services" class={sectionClass}>
            <h2 class="label">05 / Layanan & harga</h2>
            <div class="min-w-0">
                <p class="max-w-3xl text-lg leading-relaxed">
                    Pembuatan website, aplikasi web, backend API, dan pemeliharaan.
                    Harga berikut adalah biaya awal; fitur, waktu pengerjaan, dan biaya akhir disepakati sebelum proyek dimulai.
                    <span class="text-mute">Konsultasi awal tanpa biaya.</span>
                </p>

                <div class="mt-10 overflow-x-auto">
                    <table class="price w-full border-collapse text-left text-sm sm:min-w-[640px]">
                        <thead>
                            <tr class="border-y border-line">
                                <th class="label py-3 pr-4 font-normal">Layanan</th>
                                <th class="label py-3 pr-4 font-normal">Termasuk</th>
                                <th class="label py-3 pr-4 font-normal">Estimasi</th>
                                <th class="label py-3 font-normal text-right">Mulai dari</th>
                                <th class="py-3 pl-4"><span class="sr-only">Aksi</span></th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-line border-b border-line align-top">
                            {services.map((s) => <tr>
                                <td class="py-5 pr-4 text-base font-medium">{s.name}</td>
                                <td class="py-5 pr-4 text-mute">{s.scope}</td>
                                <td class="py-5 pr-4 font-mono text-xs leading-6 text-mute whitespace-nowrap">{s.time}</td>
                                <td class="py-5 text-right text-xl font-medium tracking-tight whitespace-nowrap">{s.price}{s.unit && <span class="text-sm font-normal text-mute">{s.unit}</span>}</td>
                                <td class="py-5 pl-4 text-right"><a href="mailto:wahyuakbar.work@gmail.com" data-mailto data-plan={s.plan} class="u whitespace-nowrap">Diskusikan</a></td>
                            </tr>)}
                        </tbody>
                    </table>
                </div>
                <p class="mt-4 text-sm text-mute">Harga belum termasuk domain, hosting, dan layanan pihak ketiga. Pekerjaan tambahan Rp 300 rb/jam, dengan estimasi dan persetujuan sebelum dikerjakan. Estimasi waktu dihitung setelah kebutuhan dan materi lengkap.</p>
            </div>
        </section>

        <!-- Process -->
        <section id="process" class={sectionClass}>
            <h2 class="label">06 / Cara kerja</h2>
            <ol class="grid border-t border-line sm:grid-cols-2 lg:grid-cols-3">
                {steps.map(([title, desc], i) => <li class="border-b border-line py-6 sm:pr-8">
                    <p class="label">Tahap {String(i + 1).padStart(2, '0')}</p>
                    <h3 class="mt-3 font-medium">{title}</h3>
                    <p class="mt-1 text-sm text-mute">{desc}</p>
                </li>)}
            </ol>
        </section>

        <!-- Articles -->
        <section id="articles" class={sectionClass}>
            <h2 class="label">07 / Tulisan</h2>
            <ul id="articles-list" class="divide-y divide-line border-y border-line">
                {articles.map((article) => <li>
                    <a href={`/articles/${article.slug}/`} class="group grid gap-2 py-6 sm:grid-cols-[170px_1fr]">
                        <p class="label pt-1">{articleDate(article.date)}</p>
                        <div>
                            <h3 class="font-medium group-hover:text-accent">{article.title}</h3>
                            <p class="mt-2 text-mute">{article.excerpt}</p>
                        </div>
                    </a>
                </li>)}
            </ul>
        </section>

        <!-- Contact -->
        <section id="contact" class="border-t border-line py-20 scroll-mt-16 md:py-28">
            <p class="label">08 / Kontak</p>
            <h2 class="mt-6 max-w-3xl text-4xl font-medium leading-[1.02] tracking-tight sm:text-6xl">Punya sistem<br><span class="text-mute">yang perlu dibangun</span><br><span class="text-accent">atau dirapikan</span>?</h2>
            <p class="mt-6 max-w-xl text-lg leading-relaxed text-mute">Kirim gambaran kebutuhan Anda melalui email.</p>
            <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
                <a href="mailto:wahyuakbar.work@gmail.com" data-mailto class="contact-email u font-medium tracking-tight">wahyuakbar.work@gmail.com</a>
                <button id="copy-email" data-email="wahyuakbar.work@gmail.com" class="u text-sm text-mute" aria-label="Salin alamat email"><span id="copy-email-text">Salin alamat</span></button>
            </div>
            <div class="mt-8 flex gap-6 text-sm">
                <a href="https://github.com/wahyuakbarwibowo" target="_blank" rel="noopener noreferrer" class="u">GitHub</a>
                <a href="https://www.linkedin.com/in/wahyu-akbar-wibowo" target="_blank" rel="noopener noreferrer" class="u">LinkedIn</a>
                <a href={cv} download="Wahyu_Akbar_Wibowo_CV.pdf" class="u">CV (PDF)</a>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="border-t border-line">
        <div class="mx-auto grid max-w-6xl gap-6 px-6 py-10 text-sm text-mute md:grid-cols-[1fr_auto] md:items-end">
            <div>
                <p class="font-medium text-ink">Wahyu Akbar Wibowo</p>
                <p class="mt-1">Fullstack Developer · Bojonegoro, Indonesia</p>
            </div>
            <p class="label border border-line px-3 py-1.5">&copy; <span id="year"></span> Wahyu Akbar Wibowo</p>
        </div>
    </footer>

    <!-- CV Preview Modal -->
    <div id="cv-modal" class="hidden fixed inset-0 z-50 items-center justify-center p-4 sm:p-8" role="dialog" aria-modal="true" aria-label="Pratinjau CV">
        <div class="absolute inset-0 bg-ink/60" onclick="closeCvModal()"></div>
        <div class="relative flex h-[85vh] w-full max-w-4xl flex-col overflow-hidden border border-line bg-paper">
            <div class="flex items-center justify-between gap-4 border-b border-line px-5 py-3">
                <h3 class="truncate font-medium">CV — Wahyu Akbar Wibowo</h3>
                <div class="flex shrink-0 items-center gap-5 text-sm">
                    <a href={cv} target="_blank" rel="noopener" class="u">Buka di tab baru</a>
                    <a href={cv} download="Wahyu_Akbar_Wibowo_CV.pdf" class="u">Unduh</a>
                    <button onclick="closeCvModal()" class="u" aria-label="Tutup pratinjau">Tutup</button>
                </div>
            </div>
            <iframe id="cv-frame" title="Pratinjau CV Wahyu Akbar Wibowo" class="w-full flex-grow bg-line"></iframe>
        </div>
    </div>

    <script src="./assets/js/main.js" defer></script>
</body>

</html>
