---
import articles from '../../articles.json';
import Page from '../../layouts/Page.astro';

export function getStaticPaths() {
  return articles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props;
const date = new Date(article.date).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Page title={`${article.title} | Wahyu Akbar Wibowo`} description={article.excerpt} type="article">
  <a href="/#articles" class="u text-sm text-mute">&larr; Semua tulisan</a>
  <article class="article-content mt-8">
    <p class="label">{date}</p>
    <h1 class="mt-4 text-3xl font-medium leading-[1.15] tracking-tight sm:text-4xl">{article.title}</h1>
    <div class="mt-8 text-lg text-mute [&_h2]:text-ink [&_p]:text-ink">
      {article.body.map((block) => block.type === 'h3' ? <h2 class="mt-10 text-xl font-medium">{block.text}</h2> : <p class="mt-5 leading-relaxed">{block.text}</p>)}
    </div>
  </article>
</Page>
